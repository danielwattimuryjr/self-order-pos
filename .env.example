# Local Supabase values are printed by `npx supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server-only. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Optional; only needed for the receipt email integration.
RESEND_API_KEY=re_replace-with-local-development-key
RESEND_FROM_EMAIL=receipts@example.test

# Midtrans
MIDTRANS_SERVER_KEY=<server-key>
MIDTRANS_SIGNATURE_SECRET_KEY=<midtrans-sandbox-signature-secret-key>
MIDTRANS_IS_PRODUCTION=false